{
  "name": "gare-lotti-milanesi",
  "private": true,
  "version": "1.11.2",
  "type": "module",
  "engines": {
    "node": ">=26.7 <27",
    "npm": ">=12 <13"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "deploy": "npm run deploy:cloudflare",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs production",
    "deploy:doctor": "node scripts/deploy-doctor.mjs",
    "deploy:preview": "node scripts/deploy-cloudflare.mjs preview",
    "quality:react-doctor": "react-doctor --scope full --blocking warning .",
    "preview": "vite preview --host 127.0.0.1",
    "prepublish:check": "git diff --check && npm run validate:data && npm test && npm run build && npm run smoke",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "benchmark:optimization": "vitest run --config vitest.benchmark.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:coverage:core": "vitest run --config vitest.coverage.config.ts --coverage",
    "validate:data": "vitest run src/data/tender.validation.test.ts src/data/base-scenarios.validation.test.ts",
    "validate:base": "vitest run src/data/base-scenarios.validation.test.ts",
    "package:excel": "node scripts/package-excel-vba.mjs",
    "prepublish:excel": "npm run package:excel && npm run validate:excel-package && npm run build",
    "validate:excel-package": "node scripts/validate-excel-package.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "playwright": "^1.62.1",
    "react-doctor": "0.9.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  },
  "overrides": {
    "sharp": "0.35.3",
    "undici": "7.29.0",
    "ws": "8.21.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260825.1": true
  }
}
